# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# --- AI (used from feat/ai-postmortem onward) ---
# fake = deterministic stub, no key needed (default for tests and CI)
LLM_PROVIDER=fake
# e.g. anthropic | openai | google_genai  (whichever key you have)
LLM_MODEL=
LLM_API_KEY=
# safety valves
LLM_MAX_CALLS_PER_HOUR=20
LLM_TIMEOUT_SECONDS=30

# --- Demo ---
# shrinks alert windows (5m -> 30s, 1h -> 5m) so alerts fire in minutes
DEMO_MODE=false
