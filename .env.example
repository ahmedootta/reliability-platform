# Copy to .env and fill in. .env is git-ignored. Never commit real keys.

# fake = no key needed, returns canned answers (default for learning and tests)
# groq = real calls to the Groq API
AI_PROVIDER=fake
# Get a free key at https://console.groq.com (API Keys). No quotes, no spaces.
AI_API_KEY=
# light = cheap and fast, heavy = stronger and slower (model routing, step 1.4)
AI_MODEL_LIGHT=openai/gpt-oss-20b
AI_MODEL_HEAVY=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30
# extra attempts after a failure (429, 5xx, network). Worst case wait = timeout x (1 + retries)
AI_MAX_RETRIES=1
